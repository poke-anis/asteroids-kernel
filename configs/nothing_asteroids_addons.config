# =============================================================================
#  Config fragment merged on top of  gki_defconfig + vendor/pitti_GKI.config
#  Device: Nothing Phone (3a) Pro  (asteroids / SM7635 "pitti") - kernel 6.1.157
#  Merged in CI with scripts/kconfig/merge_config.sh
# =============================================================================

# --- KernelSU-Next -----------------------------------------------------------
CONFIG_KSU=y
# Manual syscall hooks (kprobes-free). Requires the hook call-sites to exist in
# the tree. The SUSFS kernel patch adds most of them; if boot fails with KSU not
# granting root, see TODO in README about the KernelSU-Next manual-hook patch.
CONFIG_KSU_MANUAL_HOOK=y

# --- SUSFS (susfs4ksu, branch gki-android14-6.1-dev) -------------------------
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# --- Baseband-guard (vc-teahouse) LSM ----------------------------------------
# Symbol is CONFIG_BBG. Its LSM id "baseband_guard" is appended to CONFIG_LSM in
# the workflow's defconfig step (the module Makefile aborts otherwise).
CONFIG_BBG=y

# --- Mountify / overlay-fs userspace mounts ----------------------------------
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# --- Network tweaks: BBR + FQ ------------------------------------------------
# This ships BBRv1 (the only version in android14-6.1 GKI). BBRv3 is NOT a
# Kconfig option - it needs a source patch to net/ipv4/tcp_bbr.c. See README TODO.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set

# --- Thin LTO (perf; can be forced to none in CI for low-RAM runners) --------
CONFIG_LTO_CLANG_THIN=y
